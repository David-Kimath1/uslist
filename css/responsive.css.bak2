/* =========================================================
   USLIST — RESPONSIVE STYLES (SINGLE SOURCE)
   Breakpoints: 1800 → 1440 → 1200 → 1024 → 900 → 768 → 600 → 420
   ========================================================= */


/* =========================================================
   GLOBAL — PREVENT OVERFLOW
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html,
body {
    overflow-x: hidden;
    max-width: 100vw;
}

img,
svg,
video,
canvas,
iframe {
    max-width: 100%;
    height: auto;
}

/* Prevent iOS zoom on input focus */
input,
textarea,
select,
button {
    font-size: 16px;
}

@media (min-width: 900px) {
    input,
    textarea,
    select,
    button {
        font-size: inherit;
    }
}


/* =========================================================
   1200px — SMALL LAPTOPS
   ========================================================= */

@media (max-width: 1200px) {

    .content {
        padding: 32px 32px 50px;
    }

    .header {
        padding: 0 32px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .dates-grid,
    .memories-grid,
    .memory-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


/* =========================================================
   1024px — TABLETS (LANDSCAPE)
   ========================================================= */

@media (max-width: 1024px) {

    :root {
        --sidebar-width: 200px;
    }

    .content {
        padding: 28px 26px 46px;
    }

    .header {
        height: 78px;
        padding: 0 26px;
    }

    .header-title h1 {
        font-size: 21px;
    }

    .hero-card {
        min-height: 220px;
        padding: 32px 34px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .notes-grid,
    .capsule-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cycle-predictions {
        grid-template-columns: repeat(3, 1fr);
    }

}


/* =========================================================
   900px — TABLETS (PORTRAIT)
   Sidebar collapses into a drawer
   ========================================================= */

@media (max-width: 900px) {

    :root {
        --sidebar-width: 0px;
    }

    /* SIDEBAR — DRAWER */
    .sidebar {
        width: 260px;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
        z-index: 1000;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .sidebar-close {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        color: var(--text-soft);
        background: transparent;
        border: none;
        border-radius: 8px;
        font-size: 22px;
        cursor: pointer;
    }

    /* MAIN — FULL WIDTH */
    .main {
        width: 100%;
        margin-left: 0;
    }

    /* HEADER */
    .menu-button {
        display: grid;
        margin-right: 10px;
    }

    /* DRAWER BACKDROP */
    body.sidebar-open::after {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(35, 27, 29, 0.45);
        z-index: 999;
    }

    /* DASHBOARD GRIDS */
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    /* WISHLIST — TABS */
    .wishlist-tabs {
        display: flex;
    }

    .wishlist-columns {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    /* NOTES + CAPSULES */
    .notes-grid,
    .capsule-grid {
        grid-template-columns: 1fr;
    }

    /* CYCLE PREDICTIONS */
    .cycle-predictions {
        grid-template-columns: 1fr;
    }

    /* RECAP */
    .recap-content {
        padding: 24px 18px 40px;
    }

    .recap-card {
        min-height: 440px;
        padding: 36px 26px;
    }

    /* SEARCH */
    .search-overlay {
        padding: 30px 16px;
    }

    /* TOASTS + BANNERS */
    .toast-stack {
        top: 14px;
    }

    .notify-banner-stack {
        right: 16px;
        left: 16px;
        bottom: 16px;
    }

    .notify-banner {
        width: 100%;
    }

}


/* =========================================================
   768px — LARGE PHONES (LANDSCAPE)
   ========================================================= */

@media (max-width: 768px) {

    .content {
        padding: 22px 18px 40px;
    }

    .header {
        height: 72px;
        padding: 0 16px;
    }

    .header-title span {
        font-size: 11px;
    }

    .header-title h1 {
        font-size: 19px;
    }

    /* BUCKET LIST INTRO */
    .bucket-intro {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .bucket-intro .primary-button,
    .dates-add-button,
    .memory-add-button,
    .capsule-add-button,
    .wishlist-add-button,
    .notes-add-button {
        width: 100%;
        justify-content: center;
    }

    /* TOOLBARS */
    .bucket-toolbar,
    .dates-toolbar,
    .memory-toolbar,
    .timeline-toolbar,
    .notes-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .bucket-filters {
        width: 100%;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .bucket-filters::-webkit-scrollbar {
        display: none;
    }

    .filter-button {
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* GRIDS → SINGLE COLUMN */
    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid {
        grid-template-columns: 1fr;
    }

    /* STATS */
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .stat-card {
        padding: 14px;
    }

    .stat-content strong {
        font-size: 17px;
    }

    /* PROGRESS */
    .progress-circle {
        width: 130px;
        height: 130px;
    }

    .progress-circle::before {
        width: 108px;
        height: 108px;
    }

    /* HERO DECORATION — HIDE ON MOBILE */
    .hero-decoration {
        display: none;
    }

    /* CYCLE CALENDAR */
    .cycle-calendar-grid,
    .cycle-calendar-weekdays {
        gap: 3px;
    }

    .cycle-day {
        font-size: 11px;
        border-radius: 8px;
    }

    .cycle-legend {
        gap: 12px;
        font-size: 10px;
    }

    /* FORM OPTIONS */
    .category-options,
    .visibility-options {
        grid-template-columns: 1fr;
    }

    .meal-options {
        grid-template-columns: 1fr 1fr;
    }

    /* MODALS */
    .modal {
        padding: 22px;
        border-radius: 18px;
        max-width: 100%;
    }

    .modal-header h3 {
        font-size: 20px;
    }

    .note-reader-modal,
    .capsule-reader-modal {
        padding: 24px 22px;
    }

    .reader-title {
        font-size: 22px;
    }

    .reader-body {
        font-size: 14px;
        line-height: 1.75;
    }

    /* CAPSULE COUNTDOWN */
    .capsule-big-countdown {
        grid-template-columns: repeat(2, 1fr);
    }

    .capsule-big-block strong {
        font-size: 22px;
    }

    /* RECAP */
    .recap-card {
        min-height: 400px;
        padding: 30px 22px;
    }

    .recap-big {
        font-size: 80px;
    }

    .recap-title {
        font-size: 26px;
    }

    /* FOOD PICKER */
    .food-picker-actions {
        grid-template-columns: 1fr;
    }

    .food-picker-final strong {
        font-size: 22px;
    }

    .food-picker-rolling {
        font-size: 22px;
    }

    /* DASHBOARD NEXT DATE + DATES HERO */
    .dashboard-next-date,
    .dates-hero-countdown {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .dashboard-next-date-timer,
    .dates-hero-timer {
        grid-template-columns: repeat(4, 1fr);
        width: 100%;
    }

    .dates-timer-block {
        min-width: 0;
        padding: 10px 6px;
    }

    .dates-timer-block strong {
        font-size: 22px;
    }

    /* LOADERS */
    .update-loader .loader {
        --main-size: 3em;
        width: 7.3em;
        max-width: 90vw;
    }

    .plasma {
        --size: 1.2;
    }

    .heart-center i {
        font-size: 26px;
    }

    .startup-text {
        font-size: 22px;
    }

    .startup-sub {
        font-size: 12px;
    }

}


/* =========================================================
   600px — PHONES (PORTRAIT)
   ========================================================= */

@media (max-width: 600px) {

    .content {
        padding: 20px 14px 40px;
    }

    .header {
        height: 68px;
        padding: 0 14px;
    }

    .header-title h1 {
        font-size: 18px;
    }

    .header-actions {
        gap: 4px;
    }

    .icon-button,
    .profile-button,
    .menu-button {
        width: 38px;
        height: 38px;
    }

    .icon-button i,
    .profile-button i,
    .menu-button i {
        font-size: 19px;
    }

    /* HERO */
    .hero-card {
        min-height: auto;
        padding: 26px 20px;
    }

    .hero-card h2 {
        font-size: 30px;
    }

    .hero-card p {
        font-size: 12px;
    }

    /* DASHBOARD NEXT DATE + DATES HERO */
    .dashboard-next-date,
    .dates-hero-countdown {
        padding: 22px 18px;
    }

    /* CYCLE PROMPT */
    .dashboard-cycle-prompt {
        flex-direction: column;
        align-items: flex-start;
        padding: 16px;
    }

    .dashboard-cycle-button {
        width: 100%;
        justify-content: center;
    }

    /* PROFILE */
    .profile-card {
        padding: 16px;
        gap: 14px;
    }

    .profile-avatar {
        width: 56px;
        height: 56px;
        font-size: 24px;
    }

    .profile-info h2 {
        font-size: 19px;
    }

    .panel-heading {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    /* INVITE CODE */
    .invite-input {
        flex-direction: column;
    }

    .invite-input input,
    .invite-input .secondary-button {
        width: 100%;
    }

    .invite-code-card {
        padding: 20px 14px;
    }

    .invite-code-value {
        flex-direction: column;
        gap: 10px;
    }

    .invite-code-value strong {
        font-size: 26px;
        letter-spacing: 5px;
    }

    .copy-code-button {
        width: 100%;
        justify-content: center;
    }

    /* SEARCH */
    .search-panel {
        max-height: 92vh;
        border-radius: 16px;
    }

    .search-bar {
        padding: 14px 16px;
    }

    .search-bar input {
        font-size: 15px;
    }

    .search-result {
        padding: 10px 14px;
    }

    .search-result-icon {
        width: 34px;
        height: 34px;
        font-size: 16px;
    }

    /* WISHLIST */
    .wishlist-column-header h3 {
        font-size: 18px;
    }

    .wish-card {
        padding: 14px;
    }

    .wish-title {
        font-size: 16px;
    }

    .wish-form-row {
        grid-template-columns: 1fr;
    }

    /* NOTES + CAPSULES */
    .note-card {
        padding: 16px;
    }

    .note-card-title {
        font-size: 17px;
    }

    .capsule-card {
        padding: 18px;
    }

    .capsule-title {
        font-size: 17px;
    }

    /* CYCLE HISTORY */
    .cycle-history-item {
        padding: 12px 14px;
        gap: 10px;
    }

    .cycle-history-body strong {
        font-size: 12px;
    }

    .cycle-history-body span {
        font-size: 10px;
    }

    /* TIMELINE */
    .timeline-event {
        padding: 12px 14px;
        gap: 11px;
    }

    .timeline-event-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
    }

    .timeline-event-text {
        font-size: 12px;
    }

    /* RECAP */
    .recap-content {
        padding: 20px 14px 40px;
    }

    .recap-card {
        min-height: 380px;
        padding: 26px 20px;
        border-radius: 18px;
    }

    .recap-big {
        font-size: 64px;
    }

    .recap-title {
        font-size: 22px;
    }

    .recap-title-small {
        font-size: 18px;
    }

    .recap-subtitle,
    .recap-subtitle-large {
        font-size: 12px;
    }

    .recap-photo-wrap {
        width: 140px;
        height: 140px;
    }

    /* FOOD PICKER */
    .food-picker-display {
        min-height: 78px;
        padding: 16px;
    }

    /* FORM ACTIONS */
    .form-actions {
        flex-wrap: wrap;
    }

    .form-actions > * {
        flex: 1;
        justify-content: center;
    }

    /* MODALS */
    .modal {
        max-height: 92vh;
        padding: 20px;
    }

    /* LOADERS */
    .update-loader {
        gap: 24px;
        padding: 20px;
    }

    .update-loader .loader {
        --main-size: 2.5em;
        width: 7.3em;
        max-width: 90vw;
    }

    .update-sub {
        font-size: 12px;
        text-align: center;
    }

    .startup-inner {
        gap: 28px;
        padding: 20px;
    }

    .plasma {
        --size: 1;
    }

    .heart-center {
        width: 32px;
        height: 32px;
    }

    .heart-center i {
        font-size: 22px;
    }

    .startup-text {
        font-size: 20px;
    }

    .startup-sub {
        font-size: 11px;
    }

}


/* =========================================================
   420px — SMALL PHONES (iPhone SE)
   ========================================================= */

@media (max-width: 420px) {

    .content {
        padding: 16px 12px 34px;
    }

    .header {
        height: 64px;
        padding: 0 12px;
    }

    .header-title span {
        display: none;
    }

    .header-title h1 {
        font-size: 17px;
    }

    /* STATS → 1 COLUMN */
    .stats-grid {
        grid-template-columns: 1fr;
    }

    /* HERO */
    .hero-card h2 {
        font-size: 26px;
    }

    /* TIMERS → 2 COLUMNS */
    .dashboard-next-date-timer,
    .dates-hero-timer {
        grid-template-columns: repeat(2, 1fr);
    }

    /* PROFILE */
    .profile-card {
        flex-direction: column;
        align-items: flex-start;
    }

    .profile-avatar {
        width: 50px;
        height: 50px;
        font-size: 22px;
    }

    .profile-info h2 {
        font-size: 18px;
    }

    .panel-heading h2 {
        font-size: 18px;
    }

    .panel-heading p {
        max-width: 220px;
        line-height: 1.5;
    }

    .invite-code-value strong {
        font-size: 22px;
        letter-spacing: 4px;
    }

    /* CYCLE */
    .cycle-predictions {
        gap: 10px;
    }

    .cycle-card {
        padding: 14px;
    }

    .cycle-card-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
    }

    .cycle-card-body strong {
        font-size: 17px;
    }

    .cycle-day {
        font-size: 10px;
        border-radius: 6px;
    }

    /* MODAL */
    .modal {
        padding: 18px;
        border-radius: 16px;
    }

    /* READER */
    .reader-title {
        font-size: 20px;
    }

    .reader-body {
        font-size: 13px;
    }

    /* RECAP */
    .recap-big {
        font-size: 56px;
    }

    .recap-photo-wrap {
        width: 120px;
        height: 120px;
    }

    .recap-photo-placeholder {
        font-size: 32px;
    }

    /* LOADERS */
    .update-loader .loader {
        --main-size: 2em;
        max-width: 92vw;
    }

    .update-sub {
        font-size: 11px;
    }

    .plasma {
        --size: 0.9;
    }

    .heart-center {
        width: 28px;
        height: 28px;
    }

    .heart-center i {
        font-size: 20px;
    }

    .startup-text {
        font-size: 18px;
    }

    .startup-sub {
        font-size: 11px;
    }

}


/* =========================================================
   LANDSCAPE PHONES
   ========================================================= */

@media (max-height: 500px) and (orientation: landscape) {

    .header {
        height: 56px;
    }

    .recap-card {
        min-height: 300px;
        padding: 22px 24px;
    }

    .recap-big {
        font-size: 56px;
    }

    .modal {
        max-height: 95vh;
        padding: 18px;
    }

    .startup-inner {
        gap: 16px;
    }

    .update-loader {
        gap: 16px;
    }

}


/* =========================================================
   TOUCH TARGETS (mobile)
   ========================================================= */

@media (hover: none) and (pointer: coarse) {

    .filter-button,
    .primary-button,
    .secondary-button,
    .danger-button,
    .wish-reserve,
    .wish-bought,
    .item-delete,
    .item-edit,
    .memory-delete,
    .date-card-delete,
    .cycle-history-delete,
    .timeline-event-delete {
        min-height: 40px;
    }

    .date-card-delete,
    .timeline-event-delete {
        opacity: 1;
    }

    .nav-link {
        min-height: 44px;
    }

}


/* =========================================================
   SAFE AREA (iPhones with notch)
   ========================================================= */

@supports (padding: env(safe-area-inset-bottom)) {

    .sidebar {
        padding-bottom: calc(28px + env(safe-area-inset-bottom));
    }

    .notify-banner-stack {
        bottom: calc(16px + env(safe-area-inset-bottom));
    }

    .toast-stack {
        top: calc(14px + env(safe-area-inset-top));
    }

}

/* =========================================================
   SHORT LAPTOP — 1366×768 / 1366×720 / SIMILAR
   Keeps more content visible at 100% browser zoom
   ========================================================= */

@media (min-width: 901px) and (max-height: 800px) {

    /* ==================== HEADER ==================== */

    .header {
        height: 64px;
        padding: 0 26px;
    }

    .header-title span {
        font-size: 10px;
    }

    .header-title h1 {
        font-size: 20px;
    }


    /* ==================== MAIN CONTENT ==================== */

    .content {
        padding: 20px 26px 30px;
    }


    /* ==================== HERO ==================== */

    .hero-card {
        min-height: 175px;
        height: 175px;
        padding: 24px 30px;
    }

    .hero-card h2 {
        font-size: 30px;
        line-height: 1.05;
        margin-bottom: 12px;
    }

    .hero-card p {
        font-size: 12px;
        line-height: 1.45;
        max-width: 560px;
    }

    .hero-card .primary-button {
        margin-top: 14px;
    }


    /* ==================== DASHBOARD SPACING ==================== */

    .dashboard-grid {
        gap: 14px;
    }

    .stats-grid {
        gap: 12px;
    }


    /* ==================== STAT CARDS ==================== */

    .stat-card {
        padding: 12px 14px;
        min-height: 68px;
    }

    .stat-card strong {
        font-size: 18px;
    }


    /* ==================== PANELS ==================== */

    .panel {
        padding: 16px 18px;
    }

    .panel-heading {
        margin-bottom: 10px;
    }

    .panel-heading h2 {
        font-size: 21px;
    }


    /* ==================== MEAL PICKER ==================== */

    .food-picker-display {
        min-height: 64px;
        padding: 12px 16px;
    }


    /* ==================== GENERAL GRIDS ==================== */

    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid,
    .notes-grid,
    .capsule-grid {
        gap: 14px;
    }


    /* ==================== DASHBOARD DATE ==================== */

    .dashboard-next-date,
    .dates-hero-countdown {
        padding: 16px 18px;
    }


    /* ==================== PROFILE ==================== */

    .profile-card {
        padding: 14px 16px;
    }


    /* ==================== CYCLE ==================== */

    .cycle-card {
        padding: 12px 14px;
    }


    /* ==================== TOOLBARS ==================== */

    .bucket-toolbar,
    .dates-toolbar,
    .memory-toolbar,
    .timeline-toolbar,
    .notes-toolbar {
        gap: 8px;
    }
}


/* =========================================================
   LARGE DESKTOP — 1440px AND UP
   Fixes layout stretching and cramped feeling at 100% zoom
   ========================================================= */

@media (min-width: 1440px) {
    
    /* 1. Give the sidebar a comfortable fixed width */
    :root {
        --sidebar-width: 260px; 
    }

    /* 2. Constrain the main content and center it */
    .main {
        /* Prevents content from stretching to the edges of a 4K monitor */
        max-width: 1400px; 
        margin: 0 auto; /* Centers the main content */
        width: 100%;
    }

    /* 3. Add more breathing room to the header and content */
    .header {
        padding: 0 40px;
        height: 80px; /* Taller header for better proportion */
    }

    .content {
        padding: 40px 40px 60px;
    }

    /* 4. Make the hero card feel more substantial */
    .hero-card {
        min-height: 260px;
        padding: 40px 48px;
    }

    .hero-card h2 {
        font-size: 3rem; /* Larger title */
        line-height: 1.1;
    }

    .hero-card p {
        font-size: 1.1rem;
        max-width: 600px;
    }

    /* 5. Fix the Stats Grid - 4 columns looks better on wide screens */
    .stats-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .stat-card {
        padding: 20px;
        min-height: 90px;
    }

    .stat-content strong {
        font-size: 1.75rem;
    }

    /* 6. Fix the Dashboard Grid - give the meal picker more space */
    .dashboard-grid {
        grid-template-columns: 1fr; /* Stack them if they are side-by-side */
        gap: 24px;
    }

    /* 7. Make the Meal Picker look better */
    .panel {
        padding: 28px;
    }

    .panel-heading h2 {
        font-size: 1.75rem;
    }

    .food-picker-display {
        min-height: 100px;
        padding: 24px;
    }

    .food-picker-final strong,
    .food-picker-rolling {
        font-size: 28px;
    }

    /* 8. General Grid adjustments for other pages */
    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid,
    .notes-grid,
    .capsule-grid {
        grid-template-columns: repeat(3, 1fr); /* 3 columns on wide screens */
        gap: 24px;
    }
}

/* =========================================================
   EXTRA LARGE DESKTOP — 1800px AND UP
   ========================================================= */

@media (min-width: 1800px) {
    .main {
        max-width: 1600px; /* Allow a bit more width on ultra-wide */
    }
    
    .content {
        padding: 48px 60px 80px;
    }
}

/* =========================================================
   USLIST — RESPONSIVE STYLES (SINGLE SOURCE)
   Breakpoints: 1800 → 1440 → 1200 → 1024 → 900 → 768 → 600 → 420
   ========================================================= */


/* =========================================================
   GLOBAL — PREVENT OVERFLOW
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html,
body {
    overflow-x: hidden;
    max-width: 100vw;
}

img,
svg,
video,
canvas,
iframe {
    max-width: 100%;
    height: auto;
}

/* Prevent iOS zoom on input focus */
input,
textarea,
select,
button {
    font-size: 16px;
}

@media (min-width: 900px) {
    input,
    textarea,
    select,
    button {
        font-size: inherit;
    }
}


/* =========================================================
   1200px — SMALL LAPTOPS
   ========================================================= */

@media (max-width: 1200px) {

    .content {
        padding: 32px 32px 50px;
    }

    .header {
        padding: 0 32px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .dates-grid,
    .memories-grid,
    .memory-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


/* =========================================================
   1024px — TABLETS (LANDSCAPE)
   ========================================================= */

@media (max-width: 1024px) {

    :root {
        --sidebar-width: 200px;
    }

    .content {
        padding: 28px 26px 46px;
    }

    .header {
        height: 78px;
        padding: 0 26px;
    }

    .header-title h1 {
        font-size: 21px;
    }

    .hero-card {
        min-height: 220px;
        padding: 32px 34px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .notes-grid,
    .capsule-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cycle-predictions {
        grid-template-columns: repeat(3, 1fr);
    }

}


/* =========================================================
   900px — TABLETS (PORTRAIT)
   Sidebar collapses into a drawer
   ========================================================= */

@media (max-width: 900px) {

    :root {
        --sidebar-width: 0px;
    }

    /* SIDEBAR — DRAWER */
    .sidebar {
        width: 260px;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
        z-index: 1000;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .sidebar-close {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        color: var(--text-soft);
        background: transparent;
        border: none;
        border-radius: 8px;
        font-size: 22px;
        cursor: pointer;
    }

    /* MAIN — FULL WIDTH */
    .main {
        width: 100%;
        margin-left: 0;
    }

    /* HEADER */
    .menu-button {
        display: grid;
        margin-right: 10px;
    }

    /* DRAWER BACKDROP */
    body.sidebar-open::after {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(35, 27, 29, 0.45);
        z-index: 999;
    }

    /* DASHBOARD GRIDS */
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    /* WISHLIST — TABS */
    .wishlist-tabs {
        display: flex;
    }

    .wishlist-columns {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    /* NOTES + CAPSULES */
    .notes-grid,
    .capsule-grid {
        grid-template-columns: 1fr;
    }

    /* CYCLE PREDICTIONS */
    .cycle-predictions {
        grid-template-columns: 1fr;
    }

    /* RECAP */
    .recap-content {
        padding: 24px 18px 40px;
    }

    .recap-card {
        min-height: 440px;
        padding: 36px 26px;
    }

    /* SEARCH */
    .search-overlay {
        padding: 30px 16px;
    }

    /* TOASTS + BANNERS */
    .toast-stack {
        top: 14px;
    }

    .notify-banner-stack {
        right: 16px;
        left: 16px;
        bottom: 16px;
    }

    .notify-banner {
        width: 100%;
    }

}


/* =========================================================
   768px — LARGE PHONES (LANDSCAPE)
   ========================================================= */

@media (max-width: 768px) {

    .content {
        padding: 22px 18px 40px;
    }

    .header {
        height: 72px;
        padding: 0 16px;
    }

    .header-title span {
        font-size: 11px;
    }

    .header-title h1 {
        font-size: 19px;
    }

    /* BUCKET LIST INTRO */
    .bucket-intro {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .bucket-intro .primary-button,
    .dates-add-button,
    .memory-add-button,
    .capsule-add-button,
    .wishlist-add-button,
    .notes-add-button {
        width: 100%;
        justify-content: center;
    }

    /* TOOLBARS */
    .bucket-toolbar,
    .dates-toolbar,
    .memory-toolbar,
    .timeline-toolbar,
    .notes-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .bucket-filters {
        width: 100%;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .bucket-filters::-webkit-scrollbar {
        display: none;
    }

    .filter-button {
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* GRIDS → SINGLE COLUMN */
    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid {
        grid-template-columns: 1fr;
    }

    /* STATS */
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .stat-card {
        padding: 14px;
    }

    .stat-content strong {
        font-size: 17px;
    }

    /* PROGRESS */
    .progress-circle {
        width: 130px;
        height: 130px;
    }

    .progress-circle::before {
        width: 108px;
        height: 108px;
    }

    /* HERO DECORATION — HIDE ON MOBILE */
    .hero-decoration {
        display: none;
    }

    /* CYCLE CALENDAR */
    .cycle-calendar-grid,
    .cycle-calendar-weekdays {
        gap: 3px;
    }

    .cycle-day {
        font-size: 11px;
        border-radius: 8px;
    }

    .cycle-legend {
        gap: 12px;
        font-size: 10px;
    }

    /* FORM OPTIONS */
    .category-options,
    .visibility-options {
        grid-template-columns: 1fr;
    }

    .meal-options {
        grid-template-columns: 1fr 1fr;
    }

    /* MODALS */
    .modal {
        padding: 22px;
        border-radius: 18px;
        max-width: 100%;
    }

    .modal-header h3 {
        font-size: 20px;
    }

    .note-reader-modal,
    .capsule-reader-modal {
        padding: 24px 22px;
    }

    .reader-title {
        font-size: 22px;
    }

    .reader-body {
        font-size: 14px;
        line-height: 1.75;
    }

    /* CAPSULE COUNTDOWN */
    .capsule-big-countdown {
        grid-template-columns: repeat(2, 1fr);
    }

    .capsule-big-block strong {
        font-size: 22px;
    }

    /* RECAP */
    .recap-card {
        min-height: 400px;
        padding: 30px 22px;
    }

    .recap-big {
        font-size: 80px;
    }

    .recap-title {
        font-size: 26px;
    }

    /* FOOD PICKER */
    .food-picker-actions {
        grid-template-columns: 1fr;
    }

    .food-picker-final strong {
        font-size: 22px;
    }

    .food-picker-rolling {
        font-size: 22px;
    }

    /* DASHBOARD NEXT DATE + DATES HERO */
    .dashboard-next-date,
    .dates-hero-countdown {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .dashboard-next-date-timer,
    .dates-hero-timer {
        grid-template-columns: repeat(4, 1fr);
        width: 100%;
    }

    .dates-timer-block {
        min-width: 0;
        padding: 10px 6px;
    }

    .dates-timer-block strong {
        font-size: 22px;
    }

    /* LOADERS */
    .update-loader .loader {
        --main-size: 3em;
        width: 7.3em;
        max-width: 90vw;
    }

    .plasma {
        --size: 1.2;
    }

    .heart-center i {
        font-size: 26px;
    }

    .startup-text {
        font-size: 22px;
    }

    .startup-sub {
        font-size: 12px;
    }

}


/* =========================================================
   600px — PHONES (PORTRAIT)
   ========================================================= */

@media (max-width: 600px) {

    .content {
        padding: 20px 14px 40px;
    }

    .header {
        height: 68px;
        padding: 0 14px;
    }

    .header-title h1 {
        font-size: 18px;
    }

    .header-actions {
        gap: 4px;
    }

    .icon-button,
    .profile-button,
    .menu-button {
        width: 38px;
        height: 38px;
    }

    .icon-button i,
    .profile-button i,
    .menu-button i {
        font-size: 19px;
    }

    /* HERO */
    .hero-card {
        min-height: auto;
        padding: 26px 20px;
    }

    .hero-card h2 {
        font-size: 30px;
    }

    .hero-card p {
        font-size: 12px;
    }

    /* DASHBOARD NEXT DATE + DATES HERO */
    .dashboard-next-date,
    .dates-hero-countdown {
        padding: 22px 18px;
    }

    /* CYCLE PROMPT */
    .dashboard-cycle-prompt {
        flex-direction: column;
        align-items: flex-start;
        padding: 16px;
    }

    .dashboard-cycle-button {
        width: 100%;
        justify-content: center;
    }

    /* PROFILE */
    .profile-card {
        padding: 16px;
        gap: 14px;
    }

    .profile-avatar {
        width: 56px;
        height: 56px;
        font-size: 24px;
    }

    .profile-info h2 {
        font-size: 19px;
    }

    .panel-heading {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    /* INVITE CODE */
    .invite-input {
        flex-direction: column;
    }

    .invite-input input,
    .invite-input .secondary-button {
        width: 100%;
    }

    .invite-code-card {
        padding: 20px 14px;
    }

    .invite-code-value {
        flex-direction: column;
        gap: 10px;
    }

    .invite-code-value strong {
        font-size: 26px;
        letter-spacing: 5px;
    }

    .copy-code-button {
        width: 100%;
        justify-content: center;
    }

    /* SEARCH */
    .search-panel {
        max-height: 92vh;
        border-radius: 16px;
    }

    .search-bar {
        padding: 14px 16px;
    }

    .search-bar input {
        font-size: 15px;
    }

    .search-result {
        padding: 10px 14px;
    }

    .search-result-icon {
        width: 34px;
        height: 34px;
        font-size: 16px;
    }

    /* WISHLIST */
    .wishlist-column-header h3 {
        font-size: 18px;
    }

    .wish-card {
        padding: 14px;
    }

    .wish-title {
        font-size: 16px;
    }

    .wish-form-row {
        grid-template-columns: 1fr;
    }

    /* NOTES + CAPSULES */
    .note-card {
        padding: 16px;
    }

    .note-card-title {
        font-size: 17px;
    }

    .capsule-card {
        padding: 18px;
    }

    .capsule-title {
        font-size: 17px;
    }

    /* CYCLE HISTORY */
    .cycle-history-item {
        padding: 12px 14px;
        gap: 10px;
    }

    .cycle-history-body strong {
        font-size: 12px;
    }

    .cycle-history-body span {
        font-size: 10px;
    }

    /* TIMELINE */
    .timeline-event {
        padding: 12px 14px;
        gap: 11px;
    }

    .timeline-event-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
    }

    .timeline-event-text {
        font-size: 12px;
    }

    /* RECAP */
    .recap-content {
        padding: 20px 14px 40px;
    }

    .recap-card {
        min-height: 380px;
        padding: 26px 20px;
        border-radius: 18px;
    }

    .recap-big {
        font-size: 64px;
    }

    .recap-title {
        font-size: 22px;
    }

    .recap-title-small {
        font-size: 18px;
    }

    .recap-subtitle,
    .recap-subtitle-large {
        font-size: 12px;
    }

    .recap-photo-wrap {
        width: 140px;
        height: 140px;
    }

    /* FOOD PICKER */
    .food-picker-display {
        min-height: 78px;
        padding: 16px;
    }

    /* FORM ACTIONS */
    .form-actions {
        flex-wrap: wrap;
    }

    .form-actions > * {
        flex: 1;
        justify-content: center;
    }

    /* MODALS */
    .modal {
        max-height: 92vh;
        padding: 20px;
    }

    /* LOADERS */
    .update-loader {
        gap: 24px;
        padding: 20px;
    }

    .update-loader .loader {
        --main-size: 2.5em;
        width: 7.3em;
        max-width: 90vw;
    }

    .update-sub {
        font-size: 12px;
        text-align: center;
    }

    .startup-inner {
        gap: 28px;
        padding: 20px;
    }

    .plasma {
        --size: 1;
    }

    .heart-center {
        width: 32px;
        height: 32px;
    }

    .heart-center i {
        font-size: 22px;
    }

    .startup-text {
        font-size: 20px;
    }

    .startup-sub {
        font-size: 11px;
    }

}


/* =========================================================
   420px — SMALL PHONES (iPhone SE)
   ========================================================= */

@media (max-width: 420px) {

    .content {
        padding: 16px 12px 34px;
    }

    .header {
        height: 64px;
        padding: 0 12px;
    }

    .header-title span {
        display: none;
    }

    .header-title h1 {
        font-size: 17px;
    }

    /* STATS → 1 COLUMN */
    .stats-grid {
        grid-template-columns: 1fr;
    }

    /* HERO */
    .hero-card h2 {
        font-size: 26px;
    }

    /* TIMERS → 2 COLUMNS */
    .dashboard-next-date-timer,
    .dates-hero-timer {
        grid-template-columns: repeat(2, 1fr);
    }

    /* PROFILE */
    .profile-card {
        flex-direction: column;
        align-items: flex-start;
    }

    .profile-avatar {
        width: 50px;
        height: 50px;
        font-size: 22px;
    }

    .profile-info h2 {
        font-size: 18px;
    }

    .panel-heading h2 {
        font-size: 18px;
    }

    .panel-heading p {
        max-width: 220px;
        line-height: 1.5;
    }

    .invite-code-value strong {
        font-size: 22px;
        letter-spacing: 4px;
    }

    /* CYCLE */
    .cycle-predictions {
        gap: 10px;
    }

    .cycle-card {
        padding: 14px;
    }

    .cycle-card-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
    }

    .cycle-card-body strong {
        font-size: 17px;
    }

    .cycle-day {
        font-size: 10px;
        border-radius: 6px;
    }

    /* MODAL */
    .modal {
        padding: 18px;
        border-radius: 16px;
    }

    /* READER */
    .reader-title {
        font-size: 20px;
    }

    .reader-body {
        font-size: 13px;
    }

    /* RECAP */
    .recap-big {
        font-size: 56px;
    }

    .recap-photo-wrap {
        width: 120px;
        height: 120px;
    }

    .recap-photo-placeholder {
        font-size: 32px;
    }

    /* LOADERS */
    .update-loader .loader {
        --main-size: 2em;
        max-width: 92vw;
    }

    .update-sub {
        font-size: 11px;
    }

    .plasma {
        --size: 0.9;
    }

    .heart-center {
        width: 28px;
        height: 28px;
    }

    .heart-center i {
        font-size: 20px;
    }

    .startup-text {
        font-size: 18px;
    }

    .startup-sub {
        font-size: 11px;
    }

}


/* =========================================================
   LANDSCAPE PHONES
   ========================================================= */

@media (max-height: 500px) and (orientation: landscape) {

    .header {
        height: 56px;
    }

    .recap-card {
        min-height: 300px;
        padding: 22px 24px;
    }

    .recap-big {
        font-size: 56px;
    }

    .modal {
        max-height: 95vh;
        padding: 18px;
    }

    .startup-inner {
        gap: 16px;
    }

    .update-loader {
        gap: 16px;
    }

}


/* =========================================================
   TOUCH TARGETS (mobile)
   ========================================================= */

@media (hover: none) and (pointer: coarse) {

    .filter-button,
    .primary-button,
    .secondary-button,
    .danger-button,
    .wish-reserve,
    .wish-bought,
    .item-delete,
    .item-edit,
    .memory-delete,
    .date-card-delete,
    .cycle-history-delete,
    .timeline-event-delete {
        min-height: 40px;
    }

    .date-card-delete,
    .timeline-event-delete {
        opacity: 1;
    }

    .nav-link {
        min-height: 44px;
    }

}


/* =========================================================
   SAFE AREA (iPhones with notch)
   ========================================================= */

@supports (padding: env(safe-area-inset-bottom)) {

    .sidebar {
        padding-bottom: calc(28px + env(safe-area-inset-bottom));
    }

    .notify-banner-stack {
        bottom: calc(16px + env(safe-area-inset-bottom));
    }

    .toast-stack {
        top: calc(14px + env(safe-area-inset-top));
    }

}

/* =========================================================
   SHORT LAPTOP — 1366×768 / 1366×720 / SIMILAR
   Keeps more content visible at 100% browser zoom
   ========================================================= */

@media (min-width: 901px) and (max-height: 800px) {

    /* ==================== HEADER ==================== */

    .header {
        height: 64px;
        padding: 0 26px;
    }

    .header-title span {
        font-size: 10px;
    }

    .header-title h1 {
        font-size: 20px;
    }


    /* ==================== MAIN CONTENT ==================== */

    .content {
        padding: 20px 26px 30px;
    }


    /* ==================== HERO ==================== */

    .hero-card {
        min-height: 175px;
        height: 175px;
        padding: 24px 30px;
    }

    .hero-card h2 {
        font-size: 30px;
        line-height: 1.05;
        margin-bottom: 12px;
    }

    .hero-card p {
        font-size: 12px;
        line-height: 1.45;
        max-width: 560px;
    }

    .hero-card .primary-button {
        margin-top: 14px;
    }


    /* ==================== DASHBOARD SPACING ==================== */

    .dashboard-grid {
        gap: 14px;
    }

    .stats-grid {
        gap: 12px;
    }


    /* ==================== STAT CARDS ==================== */

    .stat-card {
        padding: 12px 14px;
        min-height: 68px;
    }

    .stat-card strong {
        font-size: 18px;
    }


    /* ==================== PANELS ==================== */

    .panel {
        padding: 16px 18px;
    }

    .panel-heading {
        margin-bottom: 10px;
    }

    .panel-heading h2 {
        font-size: 21px;
    }


    /* ==================== MEAL PICKER ==================== */

    .food-picker-display {
        min-height: 64px;
        padding: 12px 16px;
    }


    /* ==================== GENERAL GRIDS ==================== */

    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid,
    .notes-grid,
    .capsule-grid {
        gap: 14px;
    }


    /* ==================== DASHBOARD DATE ==================== */

    .dashboard-next-date,
    .dates-hero-countdown {
        padding: 16px 18px;
    }


    /* ==================== PROFILE ==================== */

    .profile-card {
        padding: 14px 16px;
    }


    /* ==================== CYCLE ==================== */

    .cycle-card {
        padding: 12px 14px;
    }


    /* ==================== TOOLBARS ==================== */

    .bucket-toolbar,
    .dates-toolbar,
    .memory-toolbar,
    .timeline-toolbar,
    .notes-toolbar {
        gap: 8px;
    }
}


/* =========================================================
   LARGE DESKTOP — 1440px AND UP
   Fixes layout stretching and cramped feeling at 100% zoom
   ========================================================= */

@media (min-width: 1440px) {
    
    /* 1. Give the sidebar a comfortable fixed width */
    :root {
        --sidebar-width: 260px; 
    }

    /* 2. Constrain the main content and center it */
    .main {
        /* Prevents content from stretching to the edges of a 4K monitor */
        max-width: 1400px; 
        margin: 0 auto; /* Centers the main content */
        width: 100%;
    }

    /* 3. Add more breathing room to the header and content */
    .header {
        padding: 0 40px;
        height: 80px; /* Taller header for better proportion */
    }

    .content {
        padding: 40px 40px 60px;
    }

    /* 4. Make the hero card feel more substantial */
    .hero-card {
        min-height: 260px;
        padding: 40px 48px;
    }

    .hero-card h2 {
        font-size: 3rem; /* Larger title */
        line-height: 1.1;
    }

    .hero-card p {
        font-size: 1.1rem;
        max-width: 600px;
    }

    /* 5. Fix the Stats Grid - 4 columns looks better on wide screens */
    .stats-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .stat-card {
        padding: 20px;
        min-height: 90px;
    }

    .stat-content strong {
        font-size: 1.75rem;
    }

    /* 6. Fix the Dashboard Grid - give the meal picker more space */
    .dashboard-grid {
        grid-template-columns: 1fr; /* Stack them if they are side-by-side */
        gap: 24px;
    }

    /* 7. Make the Meal Picker look better */
    .panel {
        padding: 28px;
    }

    .panel-heading h2 {
        font-size: 1.75rem;
    }

    .food-picker-display {
        min-height: 100px;
        padding: 24px;
    }

    .food-picker-final strong,
    .food-picker-rolling {
        font-size: 28px;
    }

    /* 8. General Grid adjustments for other pages */
    .categories-grid,
    .dates-grid,
    .memories-grid,
    .memory-grid,
    .notes-grid,
    .capsule-grid {
        grid-template-columns: repeat(3, 1fr); /* 3 columns on wide screens */
        gap: 24px;
    }
}

/* =========================================================
   EXTRA LARGE DESKTOP — 1800px AND UP
   ========================================================= */

@media (min-width: 1800px) {
    .main {
        max-width: 1600px; /* Allow a bit more width on ultra-wide */
    }
    
    .content {
        padding: 48px 60px 80px;
    }
}


/* =========================================================
   FIX SIDEBAR OVERFLOW
   Allows the sidebar to scroll if the screen is too short
   ========================================================= */

.sidebar {
    /* Ensure the sidebar takes full height and scrolls internally */
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    /* Hide scrollbar for a cleaner look (optional) */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
}

.sidebar::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
}

/* Push the bottom section (Us/Log out) to the very bottom if there is space */
.sidebar-bottom {
    margin-top: auto;
    padding-top: 20px; /* Add some space above it */
}
